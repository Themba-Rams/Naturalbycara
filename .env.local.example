# Copy this file to .env.local and fill in real values. Never commit
# .env.local (it's already gitignored).

# Your Supabase project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. NOT currently used by this app (the browser
# never talks to Supabase directly — every read/write goes through Next.js
# route handlers using the service role key below). Kept here in case a
# future feature needs client-side Supabase access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — full DB access, bypasses Row Level Security.
# Server-side only (src/lib/supabase.ts). NEVER expose this to the browser
# or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Plaintext password Cara enters to log into /admin. Fine for this
# solo-business use case (single admin user, no user accounts table).
ADMIN_PASSWORD=

# Secret key used to HMAC-sign the admin session cookie (src/lib/adminSession.ts).
# Use a long random string, e.g. `openssl rand -hex 32`. Deliberately
# separate from ADMIN_PASSWORD so rotating one doesn't affect the other.
SESSION_SECRET=
